<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.therivanta.uae_pass_kit">

  <!--
    Android 11+ (API 30+) package-visibility: without this <queries>
    declaration, PackageManager.getPackageInfo() for the UAE Pass app
    silently fails as if it were never installed, even when it is — a
    well-documented class of bug ("UAE Pass app not found" despite being
    installed) in prior community wrappers. Declared here, in the plugin's
    own manifest, so it merges into every consuming app automatically and
    can never be forgotten.

    Limited to staging and production only, matching this plugin's
    UaePassEnvironment — the qa/dev package IDs found while researching the
    official SDK are UAE Pass's own internal environments, never issued to
    integrators, and are intentionally not queried here.
  -->
  <queries>
    <package android:name="ae.uaepass.mainapp" />
    <package android:name="ae.uaepass.mainapp.stg" />
  </queries>

</manifest>
